# =========================================================
# rest_express — variables de entorno (staging + prod)
# =========================================================
# Plantilla. Copiar a .env en cada ambiente y rellenar.
# NUNCA commitear un .env con secretos reales.

# -------------------------------------------------------------
# ENTORNO (DES-LXP-008)
# -------------------------------------------------------------
# Identificador del entorno. Valores esperados: production | staging | development.
# Lo lee cualquier caller que necesite condicionar lógica de ambiente.
# Default en código: production.
ODOO_ENV=staging

# -------------------------------------------------------------
# ODOO
# -------------------------------------------------------------
# URL base de Odoo (sin slash final). En staging apuntar al NLB interno
# del stack `odoo-aws-staging` (DNS tipo internal-<id>.elb.amazonaws.com)
# hasta que se exponga vía Cloudflare; mientras tanto es reachable solo
# desde la VPC staging 10.1.0.0/16.
ODOO_URL=https://odoo.students.isi.edu.pa
ODOO_DB=odoo_staging
ODOO_USER=tic@isi.edu.pa
# API key de Odoo. En producción real vive en AWS Secrets Manager
# (isi/odoo/apiKey) — leer vía wrapper en runtime, NUNCA commitear valor real.
ODOO_APIKEY=__REPLACE_WITH_SECRETS_MANAGER_VALUE__

# -------------------------------------------------------------
# MOODLE
# -------------------------------------------------------------
# URL base de Moodle. Staging = lms.students.isi.edu.pa (cert wildcard).
MOODLE_URL=https://lms.students.isi.edu.pa

# Tokens de webhooks Moodle <-> Express (compartidos con Moodle plugin
# local_grupomakro_core). Placeholders — los reales van a Secrets Manager.
MOODLE_GRACE_TOKEN=__REPLACE__
MOODLE_LETTERS_WEBHOOK_TOKEN=__REPLACE__
MOODLE_REVALID_WEBHOOK_TOKEN=__REPLACE__
MOODLE_MODULE_WEBHOOK_TOKEN=__REPLACE__
MOODLE_FINANCIAL_WEBHOOK_TOKEN=__REPLACE__

# -------------------------------------------------------------
# ODOO -> EXPRESS WEBHOOKS (HMAC secrets)
# -------------------------------------------------------------
# Secretos compartidos con módulos Odoo: moodle_invoice_payment_webhook,
# subscription_oca. Defaults solo para dev local — en staging/prod usar
# valores generados y guardados en Secrets Manager.
ODOO_PAYMENT_WEBHOOK_SECRET=__REPLACE__
ODOO_LETTERS_WEBHOOK_SECRET=__REPLACE__
ODOO_REVALID_WEBHOOK_SECRET=__REPLACE__
ODOO_MODULE_WEBHOOK_SECRET=__REPLACE__

# -------------------------------------------------------------
# LXP <-> EXPRESS AUTH (aplazar / retirar / pending-invoices)
# -------------------------------------------------------------
# Shared secret con Moodle status-change wizard. Cuando está seteado, el
# middleware scoped a /api/odoo/students/* y /api/odoo/wdr/* exige
# X-Api-Key coincidente. Sin valor, endpoints quedan abiertos (legacy).
# NOTA: el módulo WDR (wdr.js) lee config.proxyApiKey (no esta variable),
# para ser consistente con auth.js. Mantener ambos valores iguales si se
# usa el override ODOO_PROXY_API_KEY en odoo_students.js.
ODOO_PROXY_API_KEY=__REPLACE__

# -------------------------------------------------------------
# MORA / OVERDUE GRACE DAYS
# -------------------------------------------------------------
# Si está definido, pisa el valor que Moodle publica en su endpoint
# overdue_grace_days.php. Útil para mantenimiento / incidentes.
# Default runtime: 3.
OVERDUE_GRACE_DAYS=

# -------------------------------------------------------------
# ADMIN BYPASS
# -------------------------------------------------------------
# Secreto del endpoint admin (bypass_config, clear-all-cache, etc.).
# NUNCA usar el default 'gmk_admin_bypass_2026' fuera de dev local.
ADMIN_SECRET=__REPLACE__

# -------------------------------------------------------------
# PRODUCTOS DEFAULT POR TIPO DE SOLICITUD
# -------------------------------------------------------------
# product.product IDs a usar cuando Moodle no envía odoo_product_id.
# Staging puede usar los mismos que prod (los productos son catálogo,
# no datos personales) o apuntar a productos sintaxis si los creamos.
ODOO_LETTERS_DEFAULT_PRODUCT_ID=
ODOO_REVALID_DEFAULT_PRODUCT_ID=
ODOO_MODULE_DEFAULT_PRODUCT_ID=
# =====================================================================
# DES-SEC-002 / DES-SEC-006
# =====================================================================
# IMPORTANTE: desde config.js, las variables de arriba marcadas como
# obligatorias YA NO TIENEN VALOR POR DEFECTO. Si falta alguna, el proceso
# NO ARRANCA (los defaults anteriores estan publicados en el repositorio).
#
# Orden de despliegue obligatorio: pm2 NO relee el entorno al reiniciar.
#   1. Poblar las variables.
#   2. pm2 restart odoo-proxy --update-env  (con el codigo ANTERIOR todavia)
#   3. Comprobar con: pm2 env <id>
#   4. Solo entonces desplegar el codigo nuevo.
# Al reves, el proceso entra en bucle de reinicios.

# Cierre de autenticacion por grupos. Vacio = todo permisivo (valida, cuenta y
# deja pasar). Se cierra un grupo cuando /api/metrics muestre que todo su
# trafico llega ya autenticado.
#   grupos: tramites | servicio | all
AUTH_ENFORCE=

# Clave anterior, valida durante una rotacion para no necesitar ventana.
ODOO_PROXY_API_KEY_PREVIOUS=

# CORS. En report-only (1) se permite todo y solo se registra el Origin, para
# construir la lista con datos reales antes de cerrar.
CORS_REPORT_ONLY=1
CORS_ALLOWED_ORIGINS=

# Certificados TLS (el proceso termina TLS directamente, sin nginx delante).
TLS_KEY_PATH=/home/ubuntu/odoo-proxy/certs/privkey.pem
TLS_CERT_PATH=/home/ubuntu/odoo-proxy/certs/fullchain.pem

# Q10 (fuente financiera legacy). No son obligatorias: si faltan, el proxy
# arranca igual pero no deja conmutar la fuente a Q10.
Q10_BASE=https://site2.q10.com
Q10_USER=
Q10_PASS=
Q10_APLENT_ID=
